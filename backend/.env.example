
# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL — replace placeholders in your local .env
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/miniledger

# JWT — generate a unique random secret for local development
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Mock OTP
OTP_TTL_MINUTES=5
